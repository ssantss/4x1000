---
import Base from './Base.astro'
import Faq from '../components/Faq.astro'
import Sources from '../components/Sources.astro'
import { GUIDES } from '../data/site.js'
import { UPDATED_LABEL } from '../data/tax.js'
import { article, breadcrumbList, faqPage } from '../lib/schema.js'

// Plantilla de guía: migas, H1, Article + BreadcrumbList (+ FAQPage y extras)
const { title, h1, description, lead, faq = [], sources, extraJsonLd = [], crumb = h1 } = Astro.props
const path = Astro.url.pathname
const jsonLd = [
  article({ title: h1, description, path }),
  breadcrumbList([{ name: 'Guías', path: '/guias/' }, { name: crumb, path }]),
  ...(faq.length ? [faqPage(faq)] : []),
  ...extraJsonLd,
]
const related = GUIDES.filter((g) => g.path !== path).slice(0, 4)
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <nav aria-label="Migas de pan" class="mb-4 text-sm text-slate-500 dark:text-slate-400">
    <a class="hover:text-blue-700 dark:hover:text-blue-400" href="/">Inicio</a>
    <span aria-hidden="true"> / </span>
    <a class="hover:text-blue-700 dark:hover:text-blue-400" href="/guias/">Guías</a>
    <span aria-hidden="true"> / </span>
    <span aria-current="page">{crumb}</span>
  </nav>

  <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-10">
    <article class="max-w-3xl">
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl dark:text-white">{h1}</h1>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">{UPDATED_LABEL}</p>
      <p class="mt-4 text-lg leading-relaxed text-slate-700 dark:text-slate-300">{lead}</p>
      <div class="prose-guide mt-6">
        <slot />
      </div>
      {faq.length > 0 && <Faq items={faq} />}
      <Sources keys={sources} />
    </article>

    <aside class="mt-12 space-y-4 lg:sticky lg:top-24 lg:mt-0 lg:self-start">
      <a href="/" class="flex min-h-11 items-center justify-center rounded-xl bg-blue-700 px-4 py-3 font-semibold text-white hover:bg-blue-800">Abrir la calculadora</a>
      <div class="card">
        <h2 class="mb-2 font-semibold text-slate-900 dark:text-white">Otras guías</h2>
        <ul class="space-y-1 text-sm">
          {related.map((g) => (
            <li><a class="flex min-h-11 items-center text-blue-700 hover:underline dark:text-blue-400" href={g.path}>{g.title}</a></li>
          ))}
        </ul>
      </div>
    </aside>
  </div>
</Base>
