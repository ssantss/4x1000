---
import Base from '../layouts/Base.astro'
import Faq from '../components/Faq.astro'
import Sources from '../components/Sources.astro'
import GmfCalculator from '../lib/GmfCalculator.svelte'
import { HOME_FAQ } from '../data/faq.js'
import { GUIDES, AMOUNTS, amountPath } from '../data/site.js'
import { TAX_YEAR, UVT, EXEMPT_CAP, LOW_AMOUNT_CAP, UPDATED_LABEL } from '../data/tax.js'
import { formatCOP } from '../lib/format.js'
import { faqPage, webApplication } from '../lib/schema.js'

const title = `Calculadora 4x1000 Colombia ${TAX_YEAR}: calcula el GMF al instante`
const description = `Calcula el 4x1000 (GMF) de cualquier monto en pesos, con o sin cuenta exenta. Tope exento ${TAX_YEAR}: ${formatCOP(EXEMPT_CAP)} al mes (350 UVT).`
const jsonLd = [
  webApplication({ name: `Calculadora 4x1000 Colombia ${TAX_YEAR}`, description, path: '/' }),
  faqPage(HOME_FAQ),
]
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <header class="mb-6 max-w-3xl">
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl dark:text-white">Calculadora 4x1000 Colombia {TAX_YEAR}</h1>
    <p class="mt-3 text-lg text-slate-700 dark:text-slate-300">
      Escribe un monto y mira al instante cuánto se lleva el Gravamen a los Movimientos Financieros (GMF),
      cuánto debes tener en la cuenta y cuánto te ahorras si tu cuenta está marcada como exenta.
    </p>
  </header>

  <GmfCalculator client:load />

  <section class="card mt-8 border-l-4 border-l-blue-700" aria-labelledby="answer-title">
    <h2 id="answer-title" class="mb-2 text-xl font-bold text-slate-900 dark:text-white">El 4x1000 en {TAX_YEAR}, en corto</h2>
    <p class="leading-relaxed">
      El 4x1000 (GMF) cobra el 0,4 % de cada retiro, transferencia o pago que sale de una cuenta en Colombia:{' '}
      {formatCOP(4000)} por cada {formatCOP(1_000_000)} (Estatuto Tributario, art. 872).{' '}
      En {TAX_YEAR} están exentos los primeros {formatCOP(EXEMPT_CAP)} al mes (350 UVT de {formatCOP(UVT)}) en la cuenta marcada como exenta,
      y {formatCOP(LOW_AMOUNT_CAP)} (65 UVT) en depósitos de bajo monto como Nequi o Daviplata (art. 879).
    </p>
    <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">{UPDATED_LABEL}.</p>
  </section>

  <section class="mt-12" aria-labelledby="guides-title">
    <h2 id="guides-title" class="mb-4 text-2xl font-bold text-slate-900 dark:text-white">Guías del 4x1000</h2>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {GUIDES.map((g) => (
        <a href={g.path} class="card block transition-colors hover:border-blue-600 dark:hover:border-blue-400">
          <span class="font-semibold text-slate-900 dark:text-white">{g.title}</span>
          <span class="mt-1 block text-sm text-slate-600 dark:text-slate-400">{g.summary}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="mt-12" aria-labelledby="amounts-title">
    <h2 id="amounts-title" class="mb-4 text-2xl font-bold text-slate-900 dark:text-white">El 4x1000 de montos comunes</h2>
    <ul class="flex flex-wrap gap-2">
      {AMOUNTS.map((a) => (
        <li>
          <a href={amountPath(a.slug)} class="inline-flex min-h-11 items-center rounded-full border border-slate-300 px-4 text-sm font-semibold hover:border-blue-600 hover:text-blue-700 dark:border-slate-700 dark:hover:border-blue-400 dark:hover:text-blue-400">
            4x1000 de {a.label}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <Faq items={HOME_FAQ} />
  <Sources keys={['rate', 'exemption', 'uvt', 'deduction', 'reform']} />
</Base>
