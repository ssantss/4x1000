---
import { SOURCES, UPDATED_LABEL } from '../data/tax.js'

// keys: fuentes de SOURCES que respaldan la página
const { keys } = Astro.props
const list = keys.map((k) => SOURCES[k])
---

<aside class="mt-12 rounded-2xl border border-slate-200 p-5 text-sm dark:border-slate-800" aria-labelledby="sources-title">
  <h2 id="sources-title" class="mb-2 font-semibold text-slate-900 dark:text-white">Fuentes</h2>
  <ul class="list-disc space-y-1 pl-5 text-slate-600 dark:text-slate-400">
    {list.map((s) => (
      <li>
        {s.url ? (
          <a class="underline underline-offset-2 hover:text-blue-700 dark:hover:text-blue-400" href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a>
        ) : s.label}
      </li>
    ))}
  </ul>
  <p class="mt-3 text-slate-500 dark:text-slate-400">{UPDATED_LABEL}. Información de referencia; confirma tu caso con tu entidad o con un contador.</p>
</aside>
