---
const path = Astro.url.pathname
const links = [
  { href: '/', label: 'Calculadora 4x1000', short: '4x1000', active: path === '/' },
  { href: '/seguridad-social/', label: 'Seguridad social', short: 'Seg. social', active: path === '/seguridad-social/' },
  { href: '/guias/', label: 'Guías', short: 'Guías', active: path !== '/' && path !== '/seguridad-social/' },
]
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur dark:border-slate-800 dark:bg-slate-950/90">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-2 px-4">
    <a href="/" class="flex min-h-11 shrink-0 items-center gap-2 rounded-lg font-bold text-slate-900 dark:text-white" aria-label="4x1000.co, inicio">
      <span class="grid h-9 w-9 place-items-center rounded-lg bg-blue-700 text-sm font-extrabold text-white" aria-hidden="true">4‰</span>
      <span class="hidden sm:inline">4x1000<span class="text-blue-700 dark:text-blue-400">.co</span></span>
    </a>
    <nav class="ml-auto flex items-center" aria-label="Principal">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={l.active ? 'page' : undefined}
          class:list={[
            'flex min-h-11 items-center rounded-lg px-2.5 text-sm font-semibold transition-colors sm:px-3',
            l.active
              ? 'text-blue-700 dark:text-blue-400'
              : 'text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white',
          ]}
        >
          <span class="md:hidden">{l.short}</span>
          <span class="hidden md:inline">{l.label}</span>
        </a>
      ))}
    </nav>
    <button
      id="theme-toggle"
      type="button"
      class="grid h-11 w-11 shrink-0 place-items-center rounded-lg text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800"
      aria-label="Cambiar entre modo claro y oscuro"
    >
      <svg class="h-5 w-5 dark:hidden" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" /></svg>
      <svg class="hidden h-5 w-5 text-amber-400 dark:block" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" /></svg>
    </button>
  </div>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark')
    try {
      localStorage.setItem('darkMode', String(dark))
    } catch (e) {}
  })
</script>
