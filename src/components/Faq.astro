---
// items: [{ q, a }] — el mismo arreglo alimenta el JSON-LD FAQPage
const { items, title = 'Preguntas frecuentes' } = Astro.props
---

<section class="mt-12" aria-labelledby="faq-title">
  <h2 id="faq-title" class="mb-4 text-2xl font-bold text-slate-900 dark:text-white">{title}</h2>
  <div class="space-y-3">
    {items.map(({ q, a }) => (
      <details class="card group p-0 sm:p-0">
        <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 rounded-2xl px-5 py-4 font-semibold text-slate-900 dark:text-white">
          {q}
          <span class="text-blue-700 transition-transform group-open:rotate-45 dark:text-blue-400" aria-hidden="true">+</span>
        </summary>
        <p class="px-5 pb-5 leading-relaxed text-slate-700 dark:text-slate-300">{a}</p>
      </details>
    ))}
  </div>
</section>
